{
  "name": "hangul-finish-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.19.0", "npm": "11.9.0" },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "test:unit": "vitest run tests/unit tests/library tests/fixtures",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "build": "vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test:deployed": "node scripts/check-deployed.mjs",
    "test:pages-path": "node scripts/check-pages-path.mjs",
    "check:constraints": "node scripts/check-constraints.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
